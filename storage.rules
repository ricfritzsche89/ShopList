rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Rezeptbilder: Nur Haushaltsmitglieder dürfen lesen und schreiben
    // Pfad-Struktur: households/{householdId}/recipes/{filename}
    match /households/{householdId}/recipes/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024  // Max 5 MB
        && request.resource.contentType.matches('image/.*');  // Nur Bilder
    }
  }
}
