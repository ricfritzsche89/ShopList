rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Hilfsfunktionen =====

    // Prüft ob der Benutzer eingeloggt ist
    function isAuthenticated() {
      return request.auth != null;
    }

    // Prüft ob der Benutzer Mitglied eines bestimmten Haushalts ist
    function isMember(householdId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/households/$(householdId)) &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    // ===== Benutzer-Dokumente =====
    match /users/{userId} {
      // Nur der Benutzer selbst darf sein Dokument lesen und schreiben
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ===== Haushalts-Dokumente =====
    match /households/{householdId} {
      // Nur Mitglieder dürfen lesen
      allow read: if isMember(householdId);

      // Erstellen: Benutzer darf einen neuen Haushalt erstellen
      // (er muss sich selbst in die members-Map eintragen)
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.members;

      // Aktualisieren: Nur Mitglieder dürfen den Haushalt bearbeiten
      allow update: if isMember(householdId);

      // Löschen: Nur der Ersteller darf löschen
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.createdBy;

      // ===== Favoriten-Unterdokumente =====
      match /favorite_items/{itemId} {
        allow read, write: if isMember(householdId);
      }

      // ===== Rezepte =====
      match /recipes/{recipeId} {
        allow read, write: if isMember(householdId);
      }

      // ===== Wochenpläne =====
      match /weekly_plans/{planId} {
        allow read, write: if isMember(householdId);
      }
    }

    // ===== Einkaufslisten =====
    // Listen-IDs folgen dem Muster: "list_{householdId}"
    match /shopping_lists/{listId} {
      function getHouseholdIdFromListId() {
        // list_Id -> Id
        return listId.split('_')[1];
      }

      allow read, write: if isMember(getHouseholdIdFromListId());

      match /items/{itemId} {
        allow read, write: if isMember(getHouseholdIdFromListId());
      }
    }
  }
}
